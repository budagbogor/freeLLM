# =================================================================
# FreeLLM Hub - Provider API Keys Configuration
# Semua provider di bawah menyediakan Tier Gratis / Permanen Free
# =================================================================

# 1. Groq (100% Gratis, Tanpa Kartu Kredit, Kecepatan Tertinggi)
# Daftar di: https://console.groq.com/keys
GROQ_API_KEY=

# 2. Google Gemini AI Studio (Konteks 1M-2M Token Gratis)
# Daftar di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 3. OpenRouter (30+ Model Gratis berakhiran :free)
# Daftar di: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 4. Cerebras (Chip Wafer CS-3, 2000+ token/detik)
# Daftar di: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# 5. SambaNova Cloud (Inference Llama 3.3 70B & DeepSeek R1)
# Daftar di: https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY=

# 6. Mistral AI (Model Mistral Small & Codestral)
# Daftar di: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# 7. Hugging Face Inference (Ribuan model open-source)
# Daftar di: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# 8. SiliconFlow / SiliconCloud (DeepSeek V3 & R1 Gratis)
# Daftar di: https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=

# 9. Cloudflare Workers AI (10,000 Neurons per hari)
# Daftar di: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# 10. Cohere (Trial Key Permanen untuk Command R & R+)
# Daftar di: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# 11. AI21 Labs (Jamba SSM-Transformer 256K)
# Daftar di: https://studio.ai21.com/account/api-key
AI21_API_KEY=

# 12. NVIDIA NIM (1,000 Free API credits setelah verifikasi HP)
# Daftar di: https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=

# 13. LLM7.io (Publik / Tanpa Registrasi Rumit)
# Token di: https://token.llm7.io
LLM7_API_KEY=

# 14. ModelScope Alibaba
# Daftar di: https://modelscope.cn/my/myaccesstoken
MODELSCOPE_API_KEY=

# Server Port (Default: 3000)
PORT=3000
